# .env.example — configuration hints for Academic-master
# This file documents runtime and Firebase configuration only. Do NOT commit
# your real Firebase config files (`google-services.json` / `GoogleService-Info.plist`).

# Web Firebase config is read from `.env` by Flutter.
# These values are public client config, not secrets.

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_DATABASE_URL=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=

# Android: place the downloaded file from Firebase Console here:
# android/app/google-services.json
# Example: copy the file into the path above. Do NOT commit it to source control.

# iOS: the file should be at:
# ios/Runner/GoogleService-Info.plist
# (This repo already contains that file.)

# Optional: environment variables your deployment may need (example):
# API_BASE_URL=
# RAZORPAY_KEY=

# Notes:
# - To obtain Android `google-services.json`:
#   1. Open Firebase Console → Project Settings → General
#   2. In the "Your apps" section, select Android and download the config file
#   3. Place it at `android/app/google-services.json`
# - To obtain iOS `GoogleService-Info.plist`: same page; for iOS apps download the plist
# - Keep these files out of version control. Add them to `.gitignore` if not already ignored.
